{% extends 'base.html.twig' %}

{% block homePage %}text-gray-500 hover:bg-gray-700 hover:bg-opacity-25 hover:text-gray-100{% endblock %}
{% block savPage %}text-gray-100 bg-gray-700 bg-opacity-25{% endblock %}
{% block clientPage %}text-gray-500 hover:bg-gray-700 hover:bg-opacity-25 hover:text-gray-100{% endblock %}
{% block articlePage %}text-gray-500 hover:bg-gray-700 hover:bg-opacity-25 hover:text-gray-100{% endblock %}

{% block header %}
    <div class="w-full flex justify-between items-center">
        <div class="flex">
            <h3 class="text-3xl font-medium text-gray-700 font-lexend">SAV {{ sav.code }}</h3>
            <p class="flex items-center font-light text-gray-700 font-lexend mt-2.5">&ensp;Informations</p>
        </div>
        <div class="inline-flex">
            <a href="{{ path('app_sav_edit', {'id': sav.id}) }}" class="bg-indigo-600 hover:bg-indigo-800 text-white text-sm font-medium pt-2.5 pb-2.5 px-4 rounded-l">Modifier</a>
            <a href="{{ path('app_sav_confirm_delete', {'id': sav.id}) }}" class="bg-red-600 hover:bg-red-800 text-white text-sm font-medium pt-2.5 pb-2.5 px-4 rounded-r">Supprimer</a>
        </div>
    </div>
{% endblock %}

{% block main %}
    <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-200">
        <div class="container px-6 py-6 mx-auto">
            <div class="w-full bg-white shadow-lg rounded-lg">
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Code</p>
                    <p class="font-lexend">{{ sav.code }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Date de création</p>
                    <p class="font-lexend">{{ sav.createdDate ? sav.createdDate|date('d/m/Y') : 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Représentant</p>
                    <p class="font-lexend">{{ sav.representative ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Panne</p>
                    <p class="font-lexend">{{ sav.breakdown ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Date prévue</p>
                    <p class="font-lexend">{{ sav.endDate ? sav.endDate|date('d/m/Y') : 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Réparateur</p>
                    <p class="font-lexend">{{ sav.repairedBy ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Réparations</p>
                    <p class="font-lexend">{{ sav.repairs ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Observations</p>
                    <p class="font-lexend">{{ sav.comments ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Coût</p>
                    <p class="font-lexend">{{ sav.charge is not empty and sav.charge != 'NONE' ? sav.charge : 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Client</p>
                    <p class="font-lexend">{{ sav.client.name ?? 'Non spécifié' }}</p>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
