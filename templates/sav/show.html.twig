{% extends 'base.html.twig' %}

{% block homePage %}text-gray-500 hover:bg-gray-700 hover:bg-opacity-25 hover:text-gray-100{% endblock %}
{% block savPage %}text-gray-100 bg-gray-700 bg-opacity-25{% endblock %}
{% block clientPage %}text-gray-500 hover:bg-gray-700 hover:bg-opacity-25 hover:text-gray-100{% endblock %}
{% block articlePage %}text-gray-500 hover:bg-gray-700 hover:bg-opacity-25 hover:text-gray-100{% endblock %}

{% block header %}
    <div class="w-full flex justify-between items-center">
        <div class="flex">
            <h3 class="text-3xl font-medium text-gray-700 font-lexend">SAV {{ sav.code }}</h3>
            <p class="flex items-center font-light text-gray-700 font-lexend mt-2.5">&ensp;Informations</p>
        </div>
        <div class="inline-flex items-center rounded-md shadow-sm">
            <a href="{{ path('app_sav_edit', {'id': sav.id}) }}" class="text-slate-800 hover:text-indigo-600 text-sm bg-white hover:bg-slate-100 border border-slate-200 rounded-l-lg font-medium px-4 py-2 inline-flex space-x-1 items-center transition-all duration-200">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"></path>
                    </svg>
                </span>
                <span class="hidden md:inline-block">Modifier</span>
            </a>
            <button class="text-slate-800 hover:text-indigo-600 text-sm bg-white hover:bg-slate-100 border-y border-slate-200 font-medium px-4 py-2 inline-flex space-x-1 items-center transition-all duration-200">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </span>
                <span class="hidden md:inline-block">Impression</span>
            </button>
            <a href="{{ path('app_sav_confirm_delete', {'id': sav.id}) }}" class="text-slate-800 hover:text-indigo-600 text-sm bg-white hover:bg-slate-100 border border-slate-200 rounded-r-lg font-medium px-4 py-2 inline-flex space-x-1 items-center transition-all duration-200">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"></path>
                    </svg>
                </span>
                <span class="hidden md:inline-block">Supprimer</span>
            </a>
        </div>
    </div>
{% endblock %}

{% block main %}
    <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-200">
        <div class="container px-6 py-6 mx-auto">
            <div class="w-full bg-white shadow-lg rounded-lg">
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Code</p>
                    <p class="font-lexend">{{ sav.code }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Date de création</p>
                    <p class="font-lexend">{{ sav.createdDate ? sav.createdDate|date('d/m/Y') : 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Représentant</p>
                    <p class="font-lexend">{{ sav.representative ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Panne</p>
                    <p class="font-lexend">{{ sav.breakdown ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Date prévue</p>
                    <p class="font-lexend">{{ sav.endDate ? sav.endDate|date('d/m/Y') : 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Réparateur</p>
                    <p class="font-lexend">{{ sav.repairedBy ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Réparations</p>
                    <p class="font-lexend">{{ sav.repairs ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Observations</p>
                    <p class="font-lexend">{{ sav.comments ?? 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Coût</p>
                    <p class="font-lexend">{{ sav.charge is not empty and sav.charge != 'NONE' ? sav.charge : 'Non spécifié' }}</p>
                </div>
                <div class="md:grid md:grid-cols-2 md:space-y-0 space-y-1 p-4 border-b">
                    <p class="font-lexend font-light text-gray-500">Client</p>
                    <p class="font-lexend">{{ sav.client.name ?? 'Non spécifié' }}</p>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
